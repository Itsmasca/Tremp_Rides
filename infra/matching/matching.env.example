# matching-py en la VM (spec 010). Copiar a /etc/tremp/matching.env (chmod 600). Nunca se sube.
# Mismo RDS y mismo Valkey que tremp-api: así comparten tablas (vistas de db/005) y el stream rides.events.

# Postgres de RDS. asyncpg necesita sslmode=require (RDS exige SSL). Base `trempapp`, no `postgres`.
DATABASE_URL=postgresql://trempapp:<clave>@<endpoint de RDS>:5432/trempapp?sslmode=require
DB_POOL_MAX_SIZE=5

# Valkey de ElastiCache con TLS + auth token: esquema rediss:// y el token como contraseña.
REDIS_URL=rediss://:<auth token>@<endpoint de Valkey>:6379/0
REDIS_STREAM=rides.events
REDIS_DLQ_STREAM=rides.events.dlq
REDIS_CONSUMER_GROUP=matching-preferences
REDIS_CONSUMER_NAME=matching-py-vm

# Bedrock con el rol de la VM (IMDS hop limit 2 ya permite que el contenedor lo use). Ver iam-vm-matching.json.
LLM_PROVIDER=bedrock
BEDROCK_REGION=us-east-1
# Claude 3.5 Haiku (default de matching-py) ya llegó a fin de vida en Bedrock: ResourceNotFoundException.
BEDROCK_LLM_MODEL_ID=us.anthropic.claude-haiku-5-5
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
EMBED_DIM=256
AWS_REGION=us-east-1

HTTP_PORT=8000
OSRM_URL=http://osrm:5000
# Debe coincidir con --max-table-size del contenedor osrm.
OSRM_MAX_TABLE_SIZE=100

CANDIDATE_RADIUS_M=1500
MAX_CANDIDATES=80
ROUTE_GEOMETRY_TOP_K=3
PICKUP_ETA_NORM_S=1800
SCORE_W_DETOUR=0.5
SCORE_W_TIME=0.3
SCORE_W_ETA=0.2
BBOX_LAT_MIN=17.8
BBOX_LAT_MAX=21.7
BBOX_LNG_MIN=-92.5
BBOX_LNG_MAX=-86.7

LOG_LEVEL=INFO
