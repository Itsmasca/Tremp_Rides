EVENTS_MAXLEN=100000
EVENTS_BATCH=100
EVENTS_BLOCK_MS=5000
EVENTS_MAX_DELIVERIES=5
EVENTS_CLAIM_IDLE_MS=30000

DB_HOST=localhost
DB_PORT=5432
DB_USER=trempapp
DB_PASSWORD=trempapp
DB_NAME=trempapp
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000

AWS_REGION=us-east-1
EVENTBRIDGE_ENABLED=false
EVENTBRIDGE_BUS=trempapp
EVENTBRIDGE_SOURCE=trempapp.backend
# EVENTBRIDGE_TYPES=trip.*,user.created   # vacío = todos
EVENTBRIDGE_FLUSH_MS=50
