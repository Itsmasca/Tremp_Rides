PORT=3000
# Orígenes permitidos para el cliente web de Expo (separados por coma)
CORS_ORIGINS=http://localhost:8081
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# true con ElastiCache (cifrado en tránsito); en local, false
REDIS_TLS=false
REDIS_PREFIX=trempapp:

EVENTS_STREAM=events
EVENTS_GROUP=trempapp
# EVENTS_CONSUMER=   # por defecto: hostname-pid
EVENTS_MAXLEN=100000
EVENTS_BATCH=100
EVENTS_BLOCK_MS=5000
EVENTS_MAX_DELIVERIES=5
EVENTS_CLAIM_IDLE_MS=30000

DB_HOST=localhost
DB_PORT=5432
DB_USER=trempapp
DB_PASSWORD=trempapp
DB_NAME=trempapp
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
# RDS exige SSL: el driver `pg` lee PGSSLMODE. En local, sin definir.
# PGSSLMODE=no-verify

# Ubicación efímera (solo Redis, nunca PostgreSQL). TTL en segundos; por defecto 1800 (30 min).
LOCATION_TTL_SEGUNDOS=1800

AWS_REGION=us-east-1
EVENTBRIDGE_ENABLED=false
EVENTBRIDGE_BUS=trempapp
EVENTBRIDGE_SOURCE=trempapp.backend
# EVENTBRIDGE_TYPES=trip.*,user.created   # vacío = todos
EVENTBRIDGE_FLUSH_MS=50
# EVENTBRIDGE_ENDPOINT=http://localhost:4566   # LocalStack

# ── Stream hacia matching-py ───────────────────────────────────────────────────
# Stream de Redis que consume matching-py para procesar preferencias con Bedrock.
# Debe coincidir con REDIS_STREAM en el .env de matching-py.
RIDES_EVENTS_STREAM=rides.events
RIDES_EVENTS_MAXLEN=200000

# ── Viajes (spec 006) ──────────────────────────────────────────────────────────
# minLng,minLat,maxLng,maxLat
PENINSULA_BBOX=-90.5,19.5,-87.4,21.7
MAX_DAYS_AHEAD=14
OVERLAP_WINDOW_MIN=60
ROUTE_MAX_POINTS=500
# Grados (~0.00005 ≈ 5 m)
ROUTE_SIMPLIFY_TOLERANCE=0.00005
ROUTE_RETENTION_HOURS=24
ROUTE_PURGE_INTERVAL_MS=600000

OSRM_URL=http://localhost:5000
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=2000

# false si corre el proceso aparte (node dist/outbox-worker.main.js)
OUTBOX_INLINE=true
OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

# ── matching-py (spec 010) ─────────────────────────────────────────────────────
# POST {MATCHING_URL}/match. En local, matching-py corre con uvicorn en :8000.
MATCHING_URL=http://localhost:8000
MATCHING_TIMEOUT_MS=3000

# Autenticación (JWT)
JWT_SECRET=cambia-esto-en-produccion
JWT_EXPIRES_IN=30d
