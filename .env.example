PORT=3000
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=trempapp:

EVENTS_STREAM=events
EVENTS_GROUP=trempapp
