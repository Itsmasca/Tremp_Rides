{
  "name": "trempapp-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.spec.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "pretest:int": "docker build -q -t trempapp-postgres:test infra/postgres",
    "test:int": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config jest.int.config.js"
  },
  "dependencies": {
    "@aws-sdk/client-eventbridge": "^3.1156.0",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/platform-fastify": "^12.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "stripe": "22.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.10",
    "@nestjs/schematics": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@swc/jest": "^0.2.39",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "jest": "^30.5.2",
    "testcontainers": "^12.2.1",
    "typescript": "~6.0"
  }
}
